@page "/Error"
@using System.Diagnostics

<PageTitle>Error — App Update Server</PageTitle>

<div class="empty-state">
    <FluentIcon Value="@(new Icons.Regular.Size48.ErrorCircle())" Color="Color.Error" />
    <h2>Something went wrong</h2>
    <p>An error occurred while processing your request. The details were written to the server log.</p>

    @if (ShowRequestId)
    {
        <p class="muted">Request ID: <code>@RequestId</code></p>
    }

    <FluentButton Appearance="ButtonAppearance.Primary" Href="/">
        Back to applications
    </FluentButton>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
