@page "/"
@rendermode InteractiveServer
@inject UpdateService Updates
@inject NavigationManager Nav
@inject INotificationService Notifications

<PageTitle>Applications — App Update Server</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title">Applications</h1>
        <p class="page-subtitle">
            @if (_apps is null)
            {
                <span>Loading…</span>
            }
            else
            {
                <span>@_apps.Count tracked @(_apps.Count == 1 ? "application" : "applications")</span>
            }
        </p>
    </div>
    <FluentButton Appearance="ButtonAppearance.Primary"
                  IconStart="@(new Icons.Regular.Size20.Add())"
                  OnClick="@(() => ShowCreate(true))">
        New application
    </FluentButton>
</div>

@if (_creating)
{
    <FluentCard Class="panel create-panel">
        <h2 class="panel-title">Register a new application</h2>
        <p class="panel-hint">
            The slug is derived from the name and is what your installed apps use to check for updates.
            Uploading to an unknown name creates the application automatically, so this is optional.
        </p>
        <FluentTextInput @bind-Value="_newName"
                         @bind-Value:after="StateHasChanged"
                         Label="Application name"
                         Placeholder="e.g. Desktop Client"
                         Autofocus="true"
                         Width="100%" />
        @if (!string.IsNullOrWhiteSpace(_newName))
        {
            <p class="slug-preview">Slug: <code>@UpdateService.GenerateSlug(_newName)</code></p>
        }
        <div class="panel-actions">
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CreateApp" Loading="_savingNew">
                Create
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => ShowCreate(false))">
                Cancel
            </FluentButton>
        </div>
    </FluentCard>
}

@if (_apps is null)
{
    <div class="centered-state">
        <FluentSpinner />
    </div>
}
else if (_apps.Count == 0)
{
    <div class="empty-state">
        <FluentIcon Value="@(new Icons.Regular.Size48.Apps())" Color="Color.Default" />
        <h2>No applications yet</h2>
        <p>
            Register one here, or just upload a version with the
            <code>aus</code> CLI — the application is created automatically.
        </p>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      IconStart="@(new Icons.Regular.Size20.Add())"
                      OnClick="@(() => ShowCreate(true))">
            New application
        </FluentButton>
    </div>
}
else
{
    @if (_apps.Count > 5)
    {
        <FluentTextInput @bind-Value="_filter"
                         @bind-Value:after="StateHasChanged"
                         Immediate="true"
                         Placeholder="Filter applications…"
                         Class="filter-box"
                         Width="100%">
            <StartTemplate>
                <FluentIcon Value="@(new Icons.Regular.Size16.Search())" Color="Color.Default" />
            </StartTemplate>
        </FluentTextInput>
    }

    <div class="app-grid">
        @foreach (var app in Filtered)
        {
            <a class="app-card" href="@($"/app/{app.Slug}")">
                <div class="app-card-head">
                    <h2>@app.Name</h2>
                    <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" Color="Color.Default" />
                </div>
                <code class="app-card-slug">@app.Slug</code>
                <div class="app-card-body">
                    @if (app.Latest is not null)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Brand">
                            @app.Latest.VersionString
                        </FluentBadge>
                        <span class="muted" title="@Format.Utc(app.Latest.UploadedAt)">
                            @Format.Relative(app.Latest.UploadedAt)
                        </span>
                    }
                    else
                    {
                        <span class="muted">No versions uploaded</span>
                    }
                </div>
                <div class="app-card-foot muted">
                    @app.TotalVersions @(app.TotalVersions == 1 ? "version" : "versions")
                    @if (app.Latest is not null)
                    {
                        <span>· @Format.Size(app.Latest.FileSizeBytes) latest</span>
                    }
                </div>
            </a>
        }
    </div>

    @if (!Filtered.Any())
    {
        <p class="muted centered-state">No application matches “@_filter”.</p>
    }
}

@code {
    private List<AppSummary>? _apps;
    private string _filter = "";
    private string _newName = "";
    private bool _creating;
    private bool _savingNew;

    private IEnumerable<AppSummary> Filtered =>
        _apps is null
            ? []
            : _apps.Where(a =>
                string.IsNullOrWhiteSpace(_filter)
                || a.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                || a.Slug.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => _apps = await Updates.GetAllAppsAsync();

    private void ShowCreate(bool show)
    {
        _creating = show;
        _newName = "";
    }

    private async Task CreateApp()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            await Notifications.ShowWarningToastAsync("Name required", "Give the application a name.");
            return;
        }

        _savingNew = true;
        try
        {
            var app = await Updates.CreateAppAsync(_newName.Trim());
            Nav.NavigateTo($"/app/{app.Slug}");
        }
        finally
        {
            _savingNew = false;
        }
    }
}
