@page "/not-found"
@layout MainLayout

<PageTitle>Not found — App Update Server</PageTitle>

<div class="empty-state">
    <FluentIcon Value="@(new Icons.Regular.Size48.QuestionCircle())" Color="Color.Default" />
    <h2>Page not found</h2>
    <p>The page you are looking for does not exist.</p>
    <FluentButton Appearance="ButtonAppearance.Primary" Href="/">
        Back to applications
    </FluentButton>
</div>
