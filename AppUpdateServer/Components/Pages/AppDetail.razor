@page "/app/{Slug}"
@rendermode InteractiveServer
@inject UpdateService Updates
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject INotificationService Notifications
@inject IJSRuntime JS

<PageTitle>@(_app?.Name ?? Slug) — App Update Server</PageTitle>

@if (_loading)
{
    <div class="centered-state">
        <FluentSpinner />
    </div>
}
else if (_app is null)
{
    <div class="empty-state">
        <FluentIcon Value="@(new Icons.Regular.Size48.QuestionCircle())" Color="Color.Default" />
        <h2>No application called “@Slug”</h2>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => Nav.NavigateTo("/"))">
            Back to applications
        </FluentButton>
    </div>
}
else
{
    <nav class="breadcrumb">
        <a href="/">Applications</a>
        <FluentIcon Value="@(new Icons.Regular.Size16.ChevronRight())" Color="Color.Default" />
        <span>@_app.Name</span>
    </nav>

    <div class="page-head">
        <div>
            <h1 class="page-title">@_app.Name</h1>
            <p class="page-subtitle">
                <code>@_app.Slug</code>
                <span>· @_versions.Count @(_versions.Count == 1 ? "version" : "versions")</span>
                @if (_versions.Count > 0)
                {
                    <span>· @Format.Size(_versions.Sum(v => v.FileSizeBytes)) stored</span>
                }
            </p>
        </div>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      IconStart="@(new Icons.Regular.Size20.Delete())"
                      OnClick="DeleteApp">
            Delete application
        </FluentButton>
    </div>

    <!-- Upload -->
    <FluentCard Class="panel">
        <h2 class="panel-title">Upload a new version</h2>

        <div class="upload-fields">
            <FluentTextInput @bind-Value="_uploadVersion"
                             Label="Version"
                             Placeholder="e.g. 3.2.0.0"
                             Required="true"
                             Width="100%" />
            <FluentTextArea @bind-Value="_uploadNotes"
                            Label="Release notes"
                            Placeholder="What changed?"
                            AutoResize="true"
                            Width="100%" />
        </div>

        <FluentInputFile Id="installer-picker"
                         Mode="InputFileMode.Stream"
                         Multiple="false"
                         MaximumFileSize="Updates.MaxUploadBytes"
                         BufferSize="262144"
                         DragDropZoneVisible="true"
                         OnFileUploaded="OnFileUploaded"
                         OnFileError="OnFileError"
                         Class="dropzone">
            <ChildContent>
                <div class="dropzone-inner">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ArrowUpload())" Color="Color.Primary" />
                    <span>Drop the installer here, or <strong>browse</strong></span>
                    <span class="muted">Up to @Format.Size(Updates.MaxUploadBytes)</span>
                </div>
            </ChildContent>
        </FluentInputFile>

        @if (_uploading)
        {
            <FluentProgressBar Value="_progress" Class="upload-progress" />
            <p class="muted">
                Uploading @_uploadingName — @Format.Size(_uploadedBytes) of
                @Format.Size(_uploadTotalBytes) (@_progress%)
            </p>
        }

        @if (_uploadError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false" Class="panel-message">
                @_uploadError
            </FluentMessageBar>
        }
    </FluentCard>

    <!-- Integration -->
    <FluentCard Class="panel">
        <h2 class="panel-title">Client integration</h2>
        <p class="panel-hint">These endpoints stay public so installed apps can reach them without SSO.</p>
        <dl class="endpoint-list">
            <dt><span class="method">POST</span> version check</dt>
            <dd>
                <code>@($"{_origin}/api/update")</code>
                @CopyButton($"{_origin}/api/update", "Version check URL")
            </dd>
            <dt><span class="method">GET</span> download</dt>
            <dd>
                <code>@($"{_origin}/api/update/download/{_app.Slug}/{{version}}")</code>
                @CopyButton($"{_origin}/api/update/download/{_app.Slug}/", "Download URL")
            </dd>
        </dl>
    </FluentCard>

    <!-- Version history -->
    <FluentCard Class="panel">
        <h2 class="panel-title">Version history</h2>

        @if (_versions.Count == 0)
        {
            <p class="muted">No versions uploaded yet.</p>
        }
        else
        {
            <FluentDataGrid Items="_versions.AsQueryable()"
                            TGridItem="VersionSummary"
                            ShowHover="true"
                            GridTemplateColumns="1.1fr 1fr 0.6fr 1.1fr 1.6fr 0.9fr">
                <TemplateColumn Title="Version" TGridItem="VersionSummary">
                    <div class="cell-version">
                        <strong>@context.VersionString</strong>
                        @if (context.Id == _versions[0].Id)
                        {
                            <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success">
                                latest
                            </FluentBadge>
                        }
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Uploaded" TGridItem="VersionSummary">
                    <span title="@Format.Utc(context.UploadedAt)">@Format.Relative(context.UploadedAt)</span>
                </TemplateColumn>
                <TemplateColumn Title="Size" TGridItem="VersionSummary">
                    @Format.Size(context.FileSizeBytes)
                </TemplateColumn>
                <TemplateColumn Title="SHA-256" TGridItem="VersionSummary">
                    <div class="cell-hash">
                        <code title="@context.Sha256Hash">@context.Sha256Hash[..12]…</code>
                        @CopyButton(context.Sha256Hash, "SHA-256")
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="Notes" TGridItem="VersionSummary">
                    <span class="cell-notes" title="@context.ReleaseNotes">@context.ReleaseNotes</span>
                </TemplateColumn>
                <TemplateColumn Title="" TGridItem="VersionSummary" Align="DataGridCellAlignment.End">
                    <div class="cell-actions">
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      IconOnly="true"
                                      Title="Download"
                                      OnClick="@(() => Download(context))">
                            <FluentIcon Value="@(new Icons.Regular.Size20.ArrowDownload())" />
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Transparent"
                                      IconOnly="true"
                                      Title="@(context.Id == _versions[0].Id ? "Roll back to the previous version" : "Delete this version")"
                                      OnClick="@(() => DeleteVersion(context))">
                            <FluentIcon Value="@(context.Id == _versions[0].Id
                                                 ? new Icons.Regular.Size20.ArrowUndo()
                                                 : (Icon)new Icons.Regular.Size20.Delete())" />
                        </FluentButton>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
        }
    </FluentCard>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private AppSummary? _app;
    private List<VersionSummary> _versions = [];
    private bool _loading = true;
    private string _origin = "";

    private string _uploadVersion = "";
    private string _uploadNotes = "";
    private string? _uploadError;
    private string _uploadingName = "";
    private bool _uploading;
    private int _progress;
    private long _uploadedBytes;
    private long _uploadTotalBytes;

    protected override async Task OnInitializedAsync()
    {
        _origin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        await LoadData();
        _loading = false;
    }

    private async Task LoadData()
    {
        _app = await Updates.GetAppBySlugAsync(Slug);
        _versions = _app is null ? [] : await Updates.GetVersionHistoryAsync(Slug);
    }

    // ── Upload ────────────────────────────────────────────────────────────────

    private async Task OnFileUploaded(FluentInputFileEventArgs file)
    {
        _uploadError = null;

        var version = _uploadVersion.Trim();
        if (!UpdateService.IsValidVersionString(version))
        {
            _uploadError = string.IsNullOrWhiteSpace(version)
                ? "Enter a version before choosing a file."
                : UpdateService.InvalidVersionMessage;
            return;
        }

        _uploading = true;
        _uploadingName = file.Name;
        _uploadTotalBytes = file.Size;
        _uploadedBytes = 0;
        _progress = 0;
        await InvokeAsync(StateHasChanged);

        try
        {
            // The component cannot see how much of the stream we have consumed,
            // so count the bytes ourselves and re-render as they arrive.
            await using var progress = new ProgressReportingStream(file.Stream!, OnBytesRead);

            var result = await Updates.UploadVersionAsync(
                Slug, version, _uploadNotes, progress, file.Name);

            if (result.Success)
            {
                await Notifications.ShowSuccessToastAsync(
                    $"Version {result.Version!.VersionString} uploaded",
                    $"{Format.Size(result.Version.FileSizeBytes)} · {file.Name}");
                _uploadVersion = "";
                _uploadNotes = "";
                await LoadData();
                Nav.NavigateTo("/");
                return;
            }

            _uploadError = result.Error;
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _uploading = false;
            _progress = 0;
            _uploadingName = "";
        }
    }

    /// <summary>
    /// Called from the stream copy, so re-render only when the whole percent
    /// changes rather than on every buffer.
    /// </summary>
    private void OnBytesRead(long totalRead)
    {
        _uploadedBytes = totalRead;

        var percent = _uploadTotalBytes > 0 ? (int)(totalRead * 100 / _uploadTotalBytes) : 0;
        if (percent == _progress)
            return;

        _progress = percent;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnFileError(FluentInputFileErrorEventArgs error) => _uploadError = error.ErrorMessage;

    // ── Actions ───────────────────────────────────────────────────────────────

    private void Download(VersionSummary version) =>
        Nav.NavigateTo($"/api/update/download/{Slug}/{version.VersionString}", forceLoad: true);

    private async Task DeleteVersion(VersionSummary version)
    {
        var isLatest = version.Id == _versions[0].Id;
        var hasPrevious = _versions.Count > 1;

        var message = isLatest && hasPrevious
            ? $"Version {version.VersionString} will be deleted and its binary removed. "
              + $"Clients will be offered {_versions[1].VersionString} instead. This cannot be undone."
            : $"Version {version.VersionString} will be deleted and its binary removed. This cannot be undone.";

        var confirmation = await Dialogs.ShowConfirmationAsync(
            message,
            isLatest && hasPrevious ? "Roll back to the previous version?" : "Delete this version?",
            isLatest && hasPrevious ? "Roll back" : "Delete",
            "Cancel");

        if (confirmation.Cancelled)
            return;

        await Updates.DeleteVersionAsync(Slug, version.Id);
        await LoadData();

        await Notifications.ShowSuccessToastAsync(
            isLatest && hasPrevious ? "Rolled back" : "Version deleted",
            isLatest && hasPrevious
                ? $"{_versions.FirstOrDefault()?.VersionString} is now the current version."
                : $"Version {version.VersionString} is gone.");
    }

    private async Task DeleteApp()
    {
        if (_app is null)
            return;

        var confirmation = await Dialogs.ShowConfirmationAsync(
            $"“{_app.Name}” and all {_versions.Count} of its "
            + $"{(_versions.Count == 1 ? "version" : "versions")} will be deleted, including every stored "
            + "binary. Installed clients will stop receiving updates. This cannot be undone.",
            "Delete this application?",
            "Delete",
            "Cancel");

        if (confirmation.Cancelled)
            return;

        await Updates.DeleteAppAsync(_app.Id);
        Nav.NavigateTo("/");
    }

    // ── Clipboard ─────────────────────────────────────────────────────────────

    private RenderFragment CopyButton(string value, string label) =>
        @<FluentButton Appearance="ButtonAppearance.Transparent"
                       IconOnly="true"
                       Title="@($"Copy {label}")"
                       OnClick="@(() => Copy(value, label))">
            <FluentIcon Value="@(new Icons.Regular.Size16.Copy())" />
        </FluentButton>;

    private async Task Copy(string value, string label)
    {
        var copied = await JS.InvokeAsync<bool>("aus.copyToClipboard", value);
        if (copied)
            await Notifications.ShowSuccessToastAsync($"{label} copied", value, 2000);
        else
            await Notifications.ShowErrorToastAsync("Could not copy", "The browser blocked clipboard access.");
    }
}
